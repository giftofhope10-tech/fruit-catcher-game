<?xml version="1.0" encoding="utf-8"?>
<!--
    Build-type overlay merged ONLY into the release build.

    tools:node="merge" explicitly instructs the manifest merger to keep this
    AD_ID declaration and merge it with any library manifest entries. This is
    safer than tools:node="replace" which could silently drop the permission
    in some AGP versions when there is no matching lower-priority node.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="merge" />

</manifest>
